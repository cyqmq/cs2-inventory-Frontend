# Base URL of the CS2 Inventory Simulator JSON API (the Cloudflare Worker).
#
# Web (browser): no env var is needed. `app/entry.client.tsx` falls back to
# `window.location.origin`, and `vite.config.ts` proxies `/api`, `/sign-in`
# and `/healthz` to WORKER_URL (default http://localhost:8787) in dev.
#
# Electron: the main process resolves the base URL in this order —
#   1. the value saved from the Settings page (electron/main.ts config)
#   2. this env var
#   3. the hardcoded production fallback in electron/main.ts
# API_BASE_URL="http://localhost:8787"
#
# Dev-only: where `npm run dev` proxies the API paths to. Read by vite.config.ts.
# WORKER_URL="http://localhost:8787"
