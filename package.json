{
  "name": "@cyqmq/cs2-inventory-app",
  "version": "3.0.0",
  "description": "CS2 Inventory Simulator Desktop Client",
  "main": "dist-electron/main.js",
  "author": "cyqmq",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:electron": "node scripts/build-electron.mjs",
    "dev": "react-router dev",
    "dev:electron": "concurrently \"react-router dev\" \"wait-on http://localhost:5173 && electron .\"",
    "format": "prettier . --write",
    "lint": "eslint",
    "start:electron": "electron .",
    "test": "vitest",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@ianlucas/cs2-lib": "^9.3.0",
    "@ianlucas/cs2-lib-inspect": "^9.0.0",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "isbot": "^5.2.2",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "remix-utils": "^10.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.1.2",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
